{
  "name": "chantier-marketplace",
  "version": "1.0.0",
  "description": "Construction materials marketplace platform with web and mobile applications",
  "main": "index.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "web": "cd web && npm start",
    "mobile": "cd mobile && npx react-native start",
    "install-all": "npm install && cd web && npm install && cd ../mobile && npm install"
  },
  "keywords": [
    "construction",
    "marketplace",
    "materials",
    "transport",
    "delivery"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
