PORT=3000
NODE_ENV=development
# En production, l'origine exacte de votre domaine (ex: https://monchantier.net) —
# plusieurs origines séparées par des virgules si le site est servi depuis plusieurs
# domaines (ex: avec et sans www).
CORS_ORIGIN=http://localhost:3002,http://localhost:8080
# Utilisé pour construire les URLs de retour PayPal (return_url/cancel_url) après
# paiement. En production, l'URL publique de ce backend (ex: https://monchantier.net,
# ou l'URL Render tant que le domaine personnalisé n'est pas encore branché). Sans
# cette variable, PayPal redirige les clients vers localhost après paiement.
APP_URL=http://localhost:3002
# Nombre de reverse proxys/load balancers de confiance devant l'app (ex: 1 derrière
# un seul proxy comme Nginx/Render/Fly). Nécessaire pour que le rate-limiting et la
# détection d'IP client se basent sur X-Forwarded-For plutôt que sur l'IP du proxy.
# Cloudflare devant Render (mode Proxied/nuage orange) ajoute un saut: TRUST_PROXY=2
# dans ce cas (voir README > Déploiement derrière un reverse proxy).
TRUST_PROXY=1
DATABASE_URL=postgresql://monchantier:change-me@localhost:5432/monchantier
PAYPAL_CLIENT_ID=replace-with-your-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-your-paypal-client-secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=monchantier-api
# Airtel Money et Orange Money sont confirmés manuellement (pas d'API de collecte
# branchée ici): le client envoie son paiement à ce numéro marchand avec la référence
# de commande, puis le staff confirme via PATCH /api/orders/:orderId/status. Un
# paiement dont le numéro n'est pas défini est refusé à la création de la commande.
AIRTEL_MONEY_PAYOUT_NUMBER=+243999000001
ORANGE_MONEY_PAYOUT_NUMBER=+243999000002
# Suivi d'erreurs (Sentry). Non défini, aucune donnée n'est envoyée nulle part: les
# erreurs restent seulement journalisées sur la sortie standard.
SENTRY_DSN=
# Connexion Google/Apple ("Sign in with Apple" = l'authentification iCloud sur iOS):
# liste des identifiants client à accepter (un par plateforme — web/iOS/Android ont
# chacun leur propre identifiant côté Google; iOS et un éventuel client web ont chacun
# le leur côté Apple), séparés par des virgules. Non définie, la route correspondante
# répond 503 plutôt que d'accepter des jetons sans savoir lesquels sont légitimes.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Code de vérification à 6 chiffres (POST /api/auth/verification/send puis /confirm),
# envoyé sur le canal choisi par le client. GET /api/auth/verification/channels
# n'annonce un canal comme disponible que si les variables correspondantes sont définies
# — jamais de faux choix affiché côté client.
# E-mail via Resend (https://resend.com) — resend._domainkey doit déjà être dans votre
# DNS pour que les e-mails ne finissent pas en spam. Sert aussi à l'e-mail de confirmation
# envoyé après chaque commande (voir README > Mes commandes et confirmation par e-mail).
RESEND_API_KEY=
RESEND_FROM_EMAIL=MonChantier <no-reply@monchantier.net>
# SMS et WhatsApp via Africa's Talking (https://africastalking.com). AFRICASTALKING_ENV=sandbox
# pour tester sans envoyer de vrais SMS. AFRICASTALKING_WHATSAPP_NUMBER: numéro WhatsApp
# Business approuvé sur votre compte — voir README, l'API WhatsApp d'Africa's Talking
# nécessite en plus un modèle de message pré-approuvé pour un premier contact.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_ENV=sandbox
AFRICASTALKING_WHATSAPP_NUMBER=
# CAPTCHA Cloudflare Turnstile sur /api/auth/register et /api/auth/login. Non définie,
# aucune vérification n'est faite (dégradation sans casser le dev local) — voir turnstile.js.
# Le site key (public, à mettre dans web/auth.html) n'est pas une variable d'environnement:
# ce n'est pas un secret, Cloudflare le documente comme destiné à être visible côté client.
TURNSTILE_SECRET_KEY=
