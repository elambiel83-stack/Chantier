# Copiez ce fichier vers .env.local (non versionné) et adaptez les valeurs à votre
# environnement. Expo inline automatiquement les variables préfixées EXPO_PUBLIC_ au
# build: elles finissent dans le bundle client, donc n'y mettez rien de secret.

# URL de l'API backend, avec /api à la fin.
# - Simulateur iOS: http://localhost:3000/api
# - Émulateur Android: http://10.0.2.2:3000/api
# - Appareil physique sur le même réseau: http://<IP locale de votre machine>:3000/api
# - Build de production: l'URL publique de l'API (https://...)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

EXPO_PUBLIC_WHATSAPP_NUMBER=+243999972466

# Identifiants OAuth Google (console Google Cloud), un par plateforme.
# Voir GOOGLE_AUTH_SETUP.md pour la procédure complète. Laissez vide pour désactiver
# le bouton de connexion Google. Le backend doit connaître les mêmes identifiants
# (GOOGLE_CLIENT_IDS dans backend/.env) sinon POST /api/auth/google répond 503.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
